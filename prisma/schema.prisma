generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Lead {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  company   String?
  employees String?
  marketingConsent Boolean @default(true)
  
  results   Result[]
  createdAt DateTime @default(now())
}

model Result {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  score     Float
  phase     Int
  answers   String   // JSON string of answers
  createdAt DateTime @default(now())
}

enum QuestionType {
  matrix_1_5
  likert_1_7
}

enum ScoringSystem {
  maturity
  communication
}

model Question {
  id              Int           @id @default(autoincrement())
  text            String
  textKa          String?
  shortLabel      String        @default("")
  shortLabelKa    String?
  order           Int           @default(0)
  questionType    QuestionType  @default(matrix_1_5)
  scoringSystem   ScoringSystem @default(maturity)
  isReverseScored Boolean       @default(false)
  construct       String?
  constructKa     String?
  answers         Answer[]
}

model Answer {
  id         Int      @id @default(autoincrement())
  text       String
  textKa     String?
  score      Int
  order      Int      @default(0)
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Phase {
  id                Int    @id @default(autoincrement())
  title             String
  titleKa           String?
  subtitle          String @default("")
  subtitleKa        String?
  color             String @default("#F05324")
  icon              String @default("Box") // Lucide icon name
  essence           String @default("")
  essenceKa         String?
  characteristics   String @default("[]")
  characteristicsKa String?
  focus             String @default("[]")
  focusKa           String?
  challenges        String @default("[]")
  challengesKa      String?
  meaningPoints     String @default("[]")
  meaningPointsKa   String?
  manifestation     String @default("{}")
  manifestationKa   String?
  benefits          String @default("[]")
  benefitsKa        String?
  recommendations   String @default("")
  recommendationsKa String?
}

model LandingStep {
  id            Int    @id @default(autoincrement())
  stepNumber    Int
  title         String
  titleKa       String?
  subtitle      String
  subtitleKa    String?
  description   String
  descriptionKa String?
  icon          String @default("Box") // Lucide icon name
}



model GlobalSettings {
  id           Int    @id @default(1)
  logoUrl      String @default("/logo.png")
  colors       String @default("{}") // JSON string: { primary: "...", secondary: "..." }
  thresholds   String @default("{}") // JSON string: { "1": 1.99, "2": 2.99 ... }
  heroTitle    String @default("Business Process Maturity Assessment")
  heroTitleKa  String?
  heroSubtitle String @default("Determine your company's stage of development and get recommendations for the next steps.")
  heroSubtitleKa String?
  buttonText   String @default("Start the Assessment")
  buttonTextKa String?
  footerText   String @default("© 2026 GEC Business. All rights reserved.")
  footerTextKa String?
  contactEmail String @default("info@gec-consulting.com")
  contactAddress String @default("Tbilisi, Georgia")
  contactAddressKa String?
  requireOtp     Boolean @default(true)

  // New Fields for Text Management
  assessmentPageTitle     String @default("Strategic Assessment")
  assessmentPageTitleKa   String?
  assessmentPageSubtitle  String @default("Please answer the questions honestly")
  assessmentPageSubtitleKa String?
  assessmentPromptText    String @default("Already completed the self-assessment? Visit this link:")
  assessmentPromptTextKa  String?
  myReportBtnText         String @default("My Report")
  myReportBtnTextKa       String?
  whyMattersTitle         String @default("Why does this matter?")
  whyMattersTitleKa       String?

  termsAndConditionsText  String @default("Please review and agree to the terms and conditions to continue with the assessment.")
  termsAndConditionsTextKa String?

  resultPageTitle         String @default("Strategic Maturity Assessment")
  resultPageTitleKa       String?
  resultPersonalReportBtn String @default("Personal Report")
  resultPersonalReportBtnKa String?
  resultCompanyReportBtn  String @default("Team Report")
  resultCompanyReportBtnKa String?
  resultOrganizationLabel String @default("Organization")
  resultOrganizationLabelKa String?
  resultScoreLabel        String @default("Score")
  resultScoreLabelKa      String?
  resultDownloadBtnText   String @default("Download Full Report (PDF)")
  resultDownloadBtnTextKa String?
  resultRestartBtnText    String @default("Start Over")
  resultRestartBtnTextKa  String?
  resultNoDataText        String @default("No data available")
  resultNoDataTextKa      String?

  phaseEssenceLabel         String @default("Essence")
  phaseEssenceLabelKa       String?
  phaseCharacteristicsLabel String @default("Key Characteristics")
  phaseCharacteristicsLabelKa String?
  phaseFocusLabel           String @default("Focus")
  phaseFocusLabelKa         String?

  bookingText   String?
  bookingTextKa String?
  bookingLink   String?

  logoWidth   Int     @default(256)
  baseFontSize Int    @default(16)
}


model SystemText {
  id    String @id @default(cuid())
  key   String @unique
  value String
  label String
}

model WhyItem {
  id            String @id @default(uuid())
  title         String
  titleKa       String?
  description   String
  descriptionKa String?
  icon          String
  order         Int
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OtpVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
