<file path="components/admin/IconPicker.tsx">
import { useState, useMemo } from 'react';
import * as rxIcons from 'lucide-react';
import { X, Search } from 'lucide-react';

// Filter out non-component exports if necessary, or just use as is. 
// Lucide exports things like `createLucideIcon`.
// We can filter by checking if it starts with uppercase.
const icons = rxIcons as any;

type IconPickerProps = {
    value: string;
    onChange: (iconName: string) => void;
};

export default function IconPicker({ value, onChange }: IconPickerProps) {
    const [isOpen, setIsOpen] = useState(false);
    const [search, setSearch] = useState("");

    // Get all icon names
    const iconNames = useMemo(() => Object.keys(icons), []);

    // Filter icons based on search
    const filteredIcons = useMemo(() => {
        return iconNames.filter(name => name.toLowerCase().includes(search.toLowerCase()));
    }, [iconNames, search]);

    // Render current icon if it exists
    const CurrentIcon = (icons as any)[value];

    return (
        <div className="relative">
            {/* Trigger Button */}
            <button
                type="button"
                onClick={() => setIsOpen(true)}
                className="flex items-center gap-2 border rounded-md px-3 py-2 w-full hover:bg-gray-50 transition-colors"
            >
                {CurrentIcon ? (
                    <>
                        <CurrentIcon className="w-5 h-5 text-gec-orange" />
                        <span className="text-gray-700">{value}</span>
                    </>
                ) : (
                    <span className="text-gray-400">Select Icon...</span>
                )}
            </button>

            {/* Modal / Popover */}
            {isOpen && (
                <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm">
                    <div className="bg-white rounded-xl shadow-2xl w-full max-w-2xl max-h-[80vh] flex flex-col">

                        {/* Header */}
                        <div className="p-4 border-b flex justify-between items-center bg-gray-50 rounded-t-xl">
                            <h3 className="font-bold text-lg text-gec-navy">Select Icon</h3>
                            <button onClick={() => setIsOpen(false)} className="p-1 hover:bg-gray-200 rounded-full">
                                <X className="w-6 h-6 text-gray-500" />
                            </button>
                        </div>

                        {/* Search */}
                        <div className="p-4 border-b">
                            <div className="relative">
                                <Search className="absolute left-3 top-2.5 w-5 h-5 text-gray-400" />
                                <input
                                    type="text"
                                    placeholder="Search icons..."
                                    className="w-full border rounded-lg pl-10 pr-4 py-2 focus:ring-2 focus:ring-gec-orange focus:outline-none text-gray-900"
                                    value={search}
                                    onChange={(e) => setSearch(e.target.value)}
                                    autoFocus
                                />
                            </div>
                        </div>

                        {/* Grid */}
                        <div className="flex-1 overflow-y-auto p-4 grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 gap-2">
                            {filteredIcons.slice(0, 100).map((name) => {
                                const Icon = (icons as any)[name];
                                return (
                                    <button
                                        key={name}
                                        onClick={() => {
                                            onChange(name);
                                            setIsOpen(false);
                                        }}
                                        className={`p-2 flex flex-col items-center justify-center rounded-lg hover:bg-orange-50 hover:text-gec-orange transition-colors ${value === name ? 'bg-orange-100 ring-2 ring-gec-orange text-gec-orange' : 'bg-gray-50 text-gray-600'}`}
                                        title={name}
                                    >
                                        <Icon className="w-6 h-6 mb-1" />
                                        <span className="text-[10px] truncate w-full text-center text-gray-600">{name}</span>
                                    </button>
                                )
                            })}
                            {filteredIcons.length === 0 && (
                                <div className="col-span-full text-center py-8 text-gray-500">No icons found.</div>
                            )}
                            {filteredIcons.length > 100 && (
                                <div className="col-span-full text-center py-2 text-xs text-gray-400">
                                    Showing top 100 matches...
                                </div>
                            )}
                        </div>
                    </div>
                </div>
            )}
        </div>
    );
}
</file>

<file path="components/admin/LeadsTable.tsx">
"use client";

import { useEffect, useState } from "react";

type Lead = {
    id: string;
    firstName: string;
    lastName: string;
    company: string | null;
    email: string;
    phone: string | null;
    employees: string | null;
    createdAt: string;
    results: { score: number; phase: number }[];
};

export default function LeadsTable() {
    const [leads, setLeads] = useState<Lead[]>([]);
    const [loading, setLoading] = useState(true);

    useEffect(() => {
        fetchLeads();
    }, []);

    const fetchLeads = async () => {
        try {
            const res = await fetch("/api/admin/leads");
            if (res.ok) {
                const data = await res.json();
                setLeads(data);
            }
        } catch (error) {
            console.error("Failed to fetch leads", error);
        } finally {
            setLoading(false);
        }
    };

    if (loading) return <div>Loading leads...</div>;

    return (
