<file path="prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Lead {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  company   String?
  employees String?
  
  results   Result[]
  createdAt DateTime @default(now())
}

model Result {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  score     Float
  phase     Int
  answers   String   // JSON string of answers
  createdAt DateTime @default(now())
}

model Question {
  id      Int      @id @default(autoincrement())
  text    String
  shortLabel String @default("")
  order   Int      @default(0)
  answers Answer[]
}

model Answer {
  id         Int      @id @default(autoincrement())
  text       String
  score      Int
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Phase {
  id              Int    @id @default(autoincrement())
  title           String
  subtitle        String @default("")
  color           String @default("#F05324")
  icon            String @default("Box") // Lucide icon name
  essence         String @default("")
  characteristics String @default("[]")
  focus           String @default("[]")
  challenges      String @default("[]")
  meaningPoints   String @default("[]")
  manifestation   String @default("{}")
  recommendations String @default("")
}

model LandingStep {
  id          Int    @id @default(autoincrement())
  stepNumber  Int
  title       String
  subtitle    String
  description String
  icon        String @default("Box") // Lucide icon name
}


model GlobalSettings {
  id           Int    @id @default(1)
  logoUrl      String @default("/logo.png")
  colors       String @default("{}") // JSON string: { primary: "...", secondary: "..." }
  thresholds   String @default("{}") // JSON string: { "1": 1.99, "2": 2.99 ... }
  heroTitle    String @default("სტრატეგიული სიმწიფის შეფასება")
  heroSubtitle String @default("განსაზღვრეთ თქვენი კომპანიის განვითარების ეტაპი და მიიღეთ რეკომენდაციები შემდეგი ნაბიჯებისთვის.")
  buttonText   String @default("შეფასების დაწყება")
  footerText   String @default("© 2026 GEC Consulting. All rights reserved.")
  contactEmail String @default("info@gec-consulting.com")
  contactAddress String @default("Tbilisi, Georgia")
}
</file>

