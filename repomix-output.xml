"use client";

import { useState, useEffect } from "react";
import { useRouter } from "next/navigation";

export default function LeadForm() {
    const router = useRouter();
    const [score, setScore] = useState<string | null>(null);
    const [formData, setFormData] = useState({
        firstName: "",
        lastName: "",
        companyName: "",
        employees: "",
        email: "",
        phone: "",
        gdpr: false,
    });

    useEffect(() => {
        // Retrieve score from previous step
        const storedScore = localStorage.getItem("assessmentScore");
        if (!storedScore) {
            router.push("/assessment"); // Redirect if no score
        }
        setScore(storedScore);
    }, [router]);

    const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {
        const { name, value, type } = e.target;
        // Handle checkbox separately
        if (type === 'checkbox') {
            const checked = (e.target as HTMLInputElement).checked;
            setFormData(prev => ({ ...prev, [name]: checked }));
        } else {
            setFormData(prev => ({ ...prev, [name]: value }));
        }
    };

    const handleSubmit = async (e: React.FormEvent) => {
        e.preventDefault();
        if (!formData.gdpr) {
            alert("გთხოვთ დაეთანხმოთ მონაცემთა დამუშავების პირობებს.");
            return;
        }

        try {
            const answers = localStorage.getItem("assessmentAnswers");

            const res = await fetch("/api/assessment/submit", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    ...formData,
                    score,
                    // phaseId calculated below
                    phaseId: getPhaseId(parseFloat(score || "0")),
                    answers: answers ? JSON.parse(answers) : {}
                }),
            });

            if (!res.ok) throw new Error("Failed to submit");

            // Store user name for Result Page personalization
            localStorage.setItem("userName", formData.firstName);
            localStorage.setItem("companyName", formData.companyName);

            router.push("/result");
        } catch (error) {
            console.error("Submission error", error);
            alert("დაფიქსირდა შეცდომა მონაცემების გაგზავნისას. გთხოვთ სცადოთ თავიდან.");
        }
    };

    // Helper for Phase ID (same as in ResultPage)
    const getPhaseId = (score: number) => {
        if (score < 2) return 1;
        if (score < 3) return 2;
        if (score < 4) return 3;
        if (score < 5) return 4;
        return 5;
    };

    return (
        <div className="w-full max-w-md mx-auto bg-white dark:bg-gec-navy p-8 rounded-2xl shadow-xl border border-gray-100 dark:border-gec-teal">
            <h2 className="text-2xl font-bold mb-6 text-gec-navy dark:text-white text-center">
                თქვენი შედეგი მზად არის!
            </h2>
            <p className="text-gray-500 text-center mb-8">
                შეიყვანეთ საკონტაქტო მონაცემები სრული რეპორტის მისაღებად.
            </p>

            <form onSubmit={handleSubmit} className="space-y-4">
                <div className="grid grid-cols-2 gap-4">
                    <div>
                        <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">სახელი</label>
                        <input
                            type="text"
                            name="firstName"
                            required
                            className="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-gec-orange focus:border-transparent outline-none dark:bg-gray-800 dark:border-gray-600"
                            onChange={handleChange}
                        />
                    </div>
                    <div>
                        <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">გვარი</label>
                        <input
                            type="text"
                            name="lastName"
                            required
                            className="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-gec-orange focus:border-transparent outline-none dark:bg-gray-800 dark:border-gray-600"
                            onChange={handleChange}
                        />
                    </div>
                </div>

                <div>
                    <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">კომპანია</label>
                    <input
                        type="text"
                        name="companyName"
                        className="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-gec-orange focus:border-transparent outline-none dark:bg-gray-800 dark:border-gray-600"
                        onChange={handleChange}
                    />
                </div>

                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">ელ-ფოსტა</label>
                        <input
                            type="email"
                            name="email"
                            required
                            className="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-gec-orange focus:border-transparent outline-none dark:bg-gray-800 dark:border-gray-600"
                            onChange={handleChange}
                        />
                    </div>
                    <div>
                        <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">ტელეფონი</label>
                        <input
                            type="tel"
                            name="phone"
                            className="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-gec-orange focus:border-transparent outline-none dark:bg-gray-800 dark:border-gray-600"
                            onChange={handleChange}
                        />
                    </div>
                </div>

                <div>
                    <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">თანამშრომლების რაოდენობა</label>
                    <select
                        name="employees"
                        className="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-gec-orange focus:border-transparent outline-none dark:bg-gray-800 dark:border-gray-600"
                        onChange={handleChange}
                    >
                        <option value="">აირჩიეთ...</option>
                        <option value="1-10">1-10</option>
                        <option value="11-50">11-50</option>
                        <option value="51-200">51-200</option>
                        <option value="200+">200+</option>
                    </select>
                </div>

                <div className="flex items-start gap-3 mt-4">
                    <input
                        type="checkbox"
                        name="gdpr"
                        id="gdpr"
                        checked={formData.gdpr}
                        onChange={handleChange}
                        className="mt-1 w-4 h-4 text-gec-orange focus:ring-gec-orange border-gray-300 rounded"
                    />
                    <label htmlFor="gdpr" className="text-xs text-gray-500">
                        ვეთანხმები პერსონალური მონაცემების დამუშავების პოლიტიკას და GEC-ის სიახლეების მიღებას.
                    </label>
                </div>

                <button
                    type="submit"
                    disabled={!formData.gdpr}
                    className="w-full py-3 bg-gec-orange text-white font-bold rounded-lg hover:bg-orange-600 transition-colors disabled:opacity-50 disabled:cursor-not-allowed mt-6"
                >
                    შედეგის ნახვა
                </button>
            </form>
        </div>
    );
}
</file>

