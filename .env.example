# Copy this file's variable names into Vercel → Project Settings → Environment Variables.
# Do NOT put real values in this file — it is meant to be committed to git.

# NextAuth
NEXTAUTH_SECRET=       # random string, e.g. `openssl rand -base64 32`
NEXTAUTH_URL=          # the real production URL, e.g. https://ba.gecbusiness.com

# Database (Neon Postgres) — Prisma reads exactly these two
POSTGRES_PRISMA_URL=       # pooled connection string (used for normal queries)
POSTGRES_URL_NON_POOLING=  # direct/unpooled connection string (used for migrations)

# Lead notification webhook (Power Automate)
POWER_AUTOMATE_WEBHOOK_URL=

# Only needed once, to run `npx prisma db seed` against a fresh database —
# not required at runtime.
# ADMIN_SEED_EMAIL=
# ADMIN_SEED_PASSWORD=
